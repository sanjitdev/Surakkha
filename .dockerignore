# Surakkha — Docker build context exclusions.
#
# Mirrors `.gitignore` so the build context (the directory tree
# Docker sends to the daemon) excludes the same files as the git
# repo. Smaller context = faster builds; also avoids the
# `COPY packages/shared/ packages/shared/` build-stage trap where
# the host tree overwrites the deps-stage `node_modules` symlink
# farm with an empty `node_modules/` directory.
#
# Each line is a glob. Patterns are matched against the *relative
# path from the build context root*.

# Dependencies — built fresh per stage, never copied from host.
node_modules/

# Build output — regenerated by tsc / Vite, never copied.
dist/
build/
.next/
.vite/
*.tsbuildinfo

# Environment — never copy host secrets into an image.
.env
.env.local
.env.*.local
!.env.example

# Logs.
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS / IDE.
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test coverage.
coverage/
*.lcov

# BMAD skill workspace (per-developer, regenerable).
_bmad/

# BMAD staging area (drafts, per-run review content).
_bmad-output/**/.working/
_bmad-output/**/.review-content-*/

# Postgres data volume (mounted via compose, not built).
postgres-data/
