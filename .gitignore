# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
.vite/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code runtime (skills, settings.json, hooks, personal CLAUDE.md).
# Per-developer install, not a project artefact — same treatment as
# `_bmad/`, `.vscode/`, `.idea/`. If a future commit needs to share
# project-specific commands/agents, uncomment the two `!.claude/...`
# lines below to allowlist the project-shared subset.
.claude/
# !.claude/commands/
# !.claude/agents/

# Coverage
coverage/
*.lcov

# BMAD skill scripts (per-developer install, not a project artefact)
_bmad/

# BMAD UX working/staging area (drafts land in .working/ then promote to mockups/)
_bmad-output/**/.working/

# BMAD review working files (per-run reviewer content; regenerable)
_bmad-output/**/.review-content-*/

# Docker volumes
postgres-data/

# Husky's internal cache (re-created on each `pnpm install`)
.husky/_/

# Scratch / diagnostic files (one-off agent probes, build logs,
# image inspections). Not part of the project; recreate locally
# from the recipes in RUNBOOK.md §5 / §9.
tmp/

# BMAD review placeholder files. The actual review artefacts live
# under `_bmad-output/implementation-artifacts/.review-*/` and are
# committed; `.review-target-*.txt` is just a marker the BMAD build
# workflow drops at the repo root.
.review-target-*.txt
