# Surakkha simulator — environment variables.
#
# The simulator is a separate Node 20 process on the same wire contract
# as a real device (architecture §2, I-12). It connects to the api over
# Socket.IO at ${API_URL}/ingest/<device_id> with an aud:"simulator" JWT
# minted from ${JWT_SECRET}.

# Base URL of the Surakkha api. The simulator appends "/ingest/<uuid>"
# to this string. Defaults to local dev.
API_URL=http://localhost:4000

# HS256 secret shared with the api. REQUIRED; must be at least 32
# characters (matches the api's `JWT_SECRET_MIN_LENGTH` fail-fast).
# The simulator refuses to boot without this set.
JWT_SECRET=replace-me-with-at-least-32-characters-please

# Story 2.5 — shared secret for the admin control HTTP server.
# Optional. When unset, the /admin/simulator tab on the SPA renders
# a calm disabled banner ("Simulator disabled. Set SIMULATOR_SECRET.")
# and the simulator's control server returns 503 on every request.
# When set, the value MUST match the api's `SIMULATOR_SECRET` env var.
SIMULATOR_SECRET=replace-me-with-the-same-shared-secret-as-the-api

# Optional. Override the simulator control HTTP server port. Default
# is 4001. The api-side URL is configured via `SIMULATOR_URL` in the
# api's env (defaults to `http://localhost:4001`).
# SIMULATOR_CONTROL_PORT=4001

# Optional. Override the per-device default tick interval (2_000 ms in
# devices.json). Must be >= 1_000 ms — the api rate-caps to 1 reading /
# 2s per device (architecture §3.2, I-2), and a faster tick would only
# trigger rate_limited envelopes.
# TICK_INTERVAL_MS=2000
