{
  "name": "@surakkha/simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Telemetry simulator. Separate Node 20 process on the same wire contract as a real device (AR-12, I-12). Six default devices, seven scenarios. JWT aud=simulator, scope=telemetry:write. Connects to the api over Socket.IO at /ingest/<device_id>.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@surakkha/shared": "workspace:*",
    "jsonwebtoken": "9.0.2",
    "pino": "9.4.0",
    "socket.io-client": "4.8.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.16.5",
    "tsx": "4.19.1",
    "typescript": "5.5.4",
    "vitest": "2.1.1"
  }
}
