{
  "name": "@surakkha/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Foundation Seam: wire contract, JWT claims, socket events, incident state enum, RBAC matrix predicate. Imported by api, web, and simulator. No epic may import a type from another epic's directory — cross-epic types live here only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./incident": {
      "types": "./dist/incident.d.ts",
      "import": "./dist/incident.js"
    },
    "./rbac": {
      "types": "./dist/rbac.d.ts",
      "import": "./dist/rbac.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./simulator": {
      "types": "./dist/simulator.d.ts",
      "import": "./dist/simulator.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "pino": "9.4.0",
    "pino-pretty": "11.2.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.16.5",
    "typescript": "5.5.4",
    "vitest": "2.1.1"
  }
}
