// Prisma schema — Surakkha (Story 2.2 + Story 2.3 seed).
// v1.0 entity set. The `Reading` and `Device` placeholders land here in
// Story 2.2 (architecture §5). The remaining entities land in their own
// stories. Adding/removing a model is a wire-contract-adjacent change;
// reviewers should re-read `docs/architecture.md` §5 before merging.
generator client {
  provider      = "prisma-client-js"
  // Prisma 5.x ships a default `linux-musl` engine linked against
  // OpenSSL 1.1, which Alpine 3.16+ no longer ships (it dropped
  // libssl1.1 in favour of openssl 3). Alpine 3.x therefore CANNOT
  // load Prisma's default binary. The runtime containers in this
  // repo are based on `node:20-bookworm-slim` (Debian), so we
  // generate only the glibc Debian binary linked against
  // OpenSSL 3 — `debian-openssl-3.0.x`. `native` covers macOS
  // dev machines. Listing both targets lets the same generated
  // client serve both dev (host) and prod (Debian runtime container).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Device — Story 2.2 placeholder, extended in Story 2.5.
// `id` (UUIDv4, the JWT `sub`) and `lastSeenAt` were the v1.0 placeholders.
// Story 2.5 adds `name` and `scenario` so the `/admin/simulator` tab can
// list the six devices and their current scenario without re-reading the
// simulator's local `devices.json`. Both columns are nullable to keep the
// forward migration safe for any rows already in the table.
model Device {
  id                String              @id
  lastSeenAt        DateTime?
  // Story 2.5: human-readable label (e.g. "DHAKA-SCHOOL-023") + the
  // currently assigned scenario. Nullable so an existing row that
  // predates Story 2.5 (only `id` + `lastSeenAt`) survives the
  // forward migration without a manual backfill step.
  name              String?
  scenario          String?
  // Story 2.7: geographic coordinates for the operator dashboard's
  // Leaflet map (`/api/devices` joins Device.lat / Device.lng into
  // the map's marker roster). Nullable so the forward migration is
  // safe for any rows that predate Story 2.7; the seed backfills the
  // six canonical device rows idempotently.
  lat               Float?
  lng               Float?
  // F-P8: Reading rows owned by this Device. ON DELETE CASCADE
  // matches the FK constraint in the migration; a removed Device
  // does not leave orphan Reading rows behind.
  readings          Reading[]           @relation("DeviceReadings")
  // Story 2.6: Incident rows owned by this Device. Same FK cascade
  // contract as `readings`; Story 4.2 may add additional incident
  // tables (IncidentEvent, IncidentAssignment) that branch off this
  // same DeviceId.
  incidents         Incident[]          @relation("DeviceIncidents")
  // Story 3.1: Rule rows scoped to this Device (NULL = global rule).
  // Same cascade contract as `readings` / `incidents`; Story 3.7's
  // admin tab edits rules via the `DeviceRules` relation.
  rules             Rule[]              @relation("DeviceRules")
  // Story 3.4: Alert rows owned by this Device. ON DELETE CASCADE
  // collapses the Device → Alert chain on a device remove.
  alerts            Alert[]             @relation("DeviceAlerts")
  // Story 3.4: RuleDebounceState rows owned by this Device. Same
  // cascade contract; no ghost timers on device re-add.
  debounceStates    RuleDebounceState[] @relation("DeviceRuleDebounceStates")
  // Story 5.4: ReadingAggregate rows owned by this Device. FK is
  // ON DELETE SET NULL (per spec Boundaries & Constraints) — a
  // deleted Device must NOT cascade-delete historical aggregates
  // (regulators may still want them); the FK row goes null and the
  // aggregate stays.
  readingAggregates ReadingAggregate[]  @relation("DeviceReadingAggregates")
}

// Reading — Story 2.2 (architecture §3.2 step 7 + §5).
// `serverReceivedAt` is the source of truth for ordering; device clock
// skew must not corrupt the timeline. `metrics` is JSON (Prisma maps
// to `jsonb`) so the v1 schema does not impose a metric shape on the
// database — the wire-contract Zod schema is the shape authority.
// `flags` is a Postgres text[] so the Story 2.2 flags (`out_of_order`,
// future `rate_limited`, `clock_skew_detected`) round-trip without a
// separate join table.
// Indexes:
//   - (deviceId, ts DESC) — primary chart query.
//   - (deviceId, seq DESC) — replay / dedup.
model Reading {
  id               String   @id @default(uuid())
  deviceId         String
  ts               DateTime
  serverReceivedAt DateTime
  metrics          Json
  seq              Int
  flags            String[] @default([])

  // F-P8: enforce the device_id authority at the DB layer. The
  // matching migration FK is the runtime authority; this relation
  // attribute keeps the Prisma client honest.
  device Device @relation("DeviceReadings", fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([deviceId, ts])
  @@index([deviceId, seq])
}

// ReadingAggregate — Story 5.4.
//
// Durable half of the retention story. Raw `Reading` rows accumulate
// forever; after 30 days they are never read by any surface (the
// operator page only renders the last 24h, the CSV export caps at
// 30 days). They are wasted disk + index bloat on a per-device index
// that grows monotonically. This table holds 5-minute
// mean/min/max/sample_count buckets, one row per `(deviceId,
// bucketStart, metric)`. Story 5.5's hourly retention cron is the
// write target (via `upsert` on the compound unique key for
// idempotent overlap-safe retries); this story ships the column
// shape only.
//
// Columns:
//   - `id` (UUIDv4, server-generated).
//   - `deviceId` (FK SET NULL → Device — a deleted Device must NOT
//      cascade-delete historical aggregates; the FK row goes null
//      and the aggregate stays).
//   - `bucketStart` (TIMESTAMP(3)) — the floor of the source
//      `Reading.ts` to the nearest 5 minutes, computed by the 5.5
//      cron (NOT by 5.4 — 5.4 ships the column shape only).
//   - `metric` (free TEXT — the closed enum
//      `{"tds","turbidity","ph","temperature","battery","signal"}`
//      lives at the Zod layer
//      `packages/shared/src/reading-aggregate.ts`; storing as TEXT
//      avoids a Prisma enum migration every time a metric is added,
//      same precedent as `AuditLog.resource`).
//   - `mean` / `min` / `max` (DOUBLE PRECISION) — bucket statistics.
//   - `sampleCount` (INTEGER) — number of raw `Reading` rows that
//      collapsed into this bucket (drives "was the bucket full?"
//      gap detection).
//
// Indexes:
//   - `@@unique([deviceId, bucketStart, metric])` — the compound
//      upsert key for Story 5.5's cron (`ON CONFLICT (...) DO UPDATE`
//      for idempotent overlap-safe retries); the constraint is the
//      load-bearing invariant.
//   - `@@index([deviceId, bucketStart])` — the (future) range-scan
//      read pattern (admin / chart query).
model ReadingAggregate {
  id          String   @id @default(uuid())
  // Nullable end-to-end with the SQL migration (Story 5.4 review
  // pass). A deleted Device MUST NOT wipe historical aggregates
  // (regulator-facing retention requirement); the FK row goes null
  // and the aggregate stays. Matching the Prisma column to the
  // SQL `TEXT` column means the Prisma client's TypeScript types
  // will accept `deviceId: null` on the read path (tombstoned rows
  // are now reachable in the typed row shape, not just in the SQL).
  deviceId    String?
  bucketStart DateTime
  metric      String
  mean        Float
  min         Float
  max         Float
  sampleCount Int

  device Device? @relation("DeviceReadingAggregates", fields: [deviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // NULLS NOT DISTINCT — the migration SQL emits the unique index
  // with `NULLS NOT DISTINCT` so two `(bucketStart, metric)` rows
  // with `deviceId IS NULL` collide (Story 5.4 review pass).
  // Without it, Postgres treats NULLs as distinct and permits
  // orphan-duplicate buckets once any Device is deleted — breaking
  // the 5.5 cron's `ON CONFLICT (...) DO UPDATE` invariant on the
  // tombstoned path. Prisma's `@@unique` does not natively emit
  // the `NULLS NOT DISTINCT` clause; the migration SQL is hand-
  // edited to include it.
  @@unique([deviceId, bucketStart, metric])
  @@index([deviceId, bucketStart])
}

// Incident — Story 2.6 placeholder expanded in Story 4.2.
//
// The dashboard's Recent Incidents preview (`/api/incidents/recent`,
// Story 2.6) reads `(id, deviceId, severity, metric, value, openedAt)`
// from this table — those 6 columns are the v1 dashboard contract.
//
// Story 4.2 (Epic 4) adds the 7-state machine (architecture §5.1):
//   - `state` (Prisma enum) drives the write-side state machine
//     (`packages/api/src/incidents/transitions.ts`).
//   - `assigneeUserId` (FK to `User`) names the assigned Technician.
//   - `acknowledgedAt` / `resolvedAt` are nullable DateTime stamps.
//   - `events` and `notifications` and `attachments` are the
//     forward-FK relations consumed by Stories 4.2 (IncidentEvent),
//     4.9 (Notification), and 4.13 (Attachment).
//
// `severity` is intentionally a free-form `String` (NOT a Prisma enum)
// because the dashboard bucket-set can pivot without forcing an
// Incident migration. The api validates `severity ∈
// {"info","warning","critical"}` at the wire boundary (see
// `incidents/recentRouter`).
//
// Index:
//   - (deviceId, openedAt DESC) — primary dashboard query path (2.6).
//   - (state, openedAt DESC) — Kanban query (4.3, deferred).
model Incident {
  id             String         @id @default(uuid())
  deviceId       String
  severity       String
  metric         String
  value          Float
  openedAt       DateTime       @default(now())
  // Story 4.2 — state machine. `OPEN` is the default so an auto-created
  // row from Story 3.6's path lands in OPEN without a write.
  state          IncidentState_ @default(OPEN)
  // Story 4.6 / 4.7 — the assigned Technician. NULL while unassigned.
  // FK target: `User.id`. ON DELETE SET NULL because removing a user
  // must NOT cascade-delete the incident — audit history requires the
  // incident row to outlive its assignee.
  assigneeUserId String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  device        Device          @relation("DeviceIncidents", fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignee      User?           @relation("IncidentAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  events        IncidentEvent[] @relation("IncidentEvents")
  notifications Notification[]  @relation("IncidentNotifications")
  attachments   Attachment[]    @relation("IncidentAttachments")

  @@index([deviceId, openedAt])
  @@index([state, openedAt])
}

// Story 4.2 — incident state enum. Mirrors `IncidentStateSchema` in
// `packages/shared/src/incident.ts` 1:1 — kept distinct from the
// Zod-extrapolated literal union so the wire-contract and the DB
// stay in lockstep (same source-walk pattern as `RuleMetric`).
//
// `REOPENED` is a transition alias: the reopen path writes
// `state: "OPEN"` rather than `REOPENED`. The enum member exists
// so the schema can describe the wire-state if Story 4.11 changes
// its mind; the Epics 1-3 README documents the alias.
enum IncidentState_ {
  OPEN
  ACKNOWLEDGED
  INSPECTING
  SAFE
  UNSAFE
  MONITORING
  RESOLVED
  REOPENED
}

// Story 4.2 — audit event types. `__invalid_transition_attempt` is
// the only synthetic type; the rest mirror the RBAC `Action` verbs
// from `packages/shared/src/rbac.ts`.
enum IncidentEventType_ {
  acknowledge
  assign
  submit_result
  resolve
  reopen
  invalid_transition_attempt
}

// Story 4.2 — IncidentEvent audit row. Every successful transition
// writes one row in the SAME `$transaction` as the `Incident.update`
// (atomicity pinned in `incident-state-machine.spec.ts`). Every
// failed/rejected attempt ALSO writes a row with
// `type: "__invalid_transition_attempt"` (the `payload` carries the
// attempted action + the actual current state).
//
// `actorUserId` is FK to `User.id`; NULL is allowed ONLY when an
// Actor is system-driven (e.g., the auto-create path from Story 3.6
// has no human actor). Production routes should always set a real
// actor; the NULL is a forward-compatible escape hatch for tests
// and for cron-driven transitions Epic 6 owns.
//
// `@@index([incidentId, createdAt])` is the per-incident timeline
// query path; the detail page (Story 4.4, deferred) consumes it
// 1:1 with `ORDER BY createdAt ASC`.
model IncidentEvent {
  id          String             @id @default(uuid())
  incidentId  String
  actorUserId String?
  type        IncidentEventType_
  payload     Json
  createdAt   DateTime           @default(now())

  incident Incident @relation("IncidentEvents", fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor    User?    @relation("IncidentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([incidentId, createdAt])
}

// Story 4.9 — Notification table.
//
// Every `notification:critical` / `notification:warning` event
// emitted by the engine lands here. The read view (`/admin/notifications`)
// is Epic 5 Story 5.1; the bell dropdown is Story 4.10 (deferred).
//
// `idempotency`: the partial unique index on `(incidentId, severity) WHERE
// "acknowledgedAt" IS NULL` enforces at-most-one-active-banner per
// (incident, severity) key. Two concurrent `writeNotification` calls
// collapse to a single Notification row (P2002 caught + refetch —
// see `notificationWriter.ts` AC5).
//
// `alertId` is nullable because not every notification is incident-
// backed (Epic 6 will introduce `notification:rate_limit` warnings
// from the ingest path that carry no incident; the schema allows
// that without a follow-up migration).
model Notification {
  id                   String                     @id @default(uuid())
  severity             NotificationSeverity_
  incidentId           String?
  alertId              String?
  recipientRole        NotificationRecipientRole_
  createdAt            DateTime                   @default(now())
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?

  incident       Incident? @relation("IncidentNotifications", fields: [incidentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Alert.id is added by the same migration that adds Notification
  // (4.2 + 4.9 ship together); FK targets `Alert.id`. ON DELETE
  // SET NULL because an alert can be hard-deleted without losing
  // its notification history.
  alert          Alert?    @relation("AlertNotifications", fields: [alertId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  acknowledgedBy User?     @relation("NotificationAcknowledger", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([recipientRole, createdAt])
}

// Story 4.9 — notification severity enum. Same triple as the wire
// contract (`info | warning | critical`); 4.9 only emits warning +
// critical (info reserved for Epic 6 cron warnings).
enum NotificationSeverity_ {
  info
  warning
  critical
}

// Story 4.9 — recipient role enum. Duplicated from `RoleSchema`
// in `packages/shared/src/rbac.ts` because Prisma enums must be
// declared in the schema file; the source-walk pin in
// `packages/db/__tests__/notification-schema.spec.ts` (added in
// 4.9) catches drift between the two surfaces.
enum NotificationRecipientRole_ {
  Admin
  Operator
  Technician
  Viewer
}

// Story 4.13 — Attachment table. The WRITE endpoint ships in 4.13
// (deferred). The TABLE lands in this migration so we don't pay a
// second forward migration when 4.13 lands.
//
// `url` is a free-form `String`; v1 has no binary storage. The
// application validates the URL scheme (`http`/`https` only,
// no `javascript:`/`data:`) at the wire boundary — see deferred
// Story 4.13 spec.
model Attachment {
  id               String   @id @default(uuid())
  incidentId       String
  url              String
  label            String?
  mime             String?
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  incident   Incident @relation("IncidentAttachments", fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploadedBy User?    @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([incidentId, createdAt])
}

// Story 4.2 — User table.
//
// `id` is the JWT `sub` (UUIDv4 — the same value carried in the
// login token). `role` is a closed Prisma enum matching the wire
// contract (`Admin | Operator | Technician | Viewer`). The seed
// script (`seedUsers.ts`) upserts the demo-user set on every
// `pnpm db:seed`; the api also lazy-upserts on first JWT sight
// (defense-in-depth — see `resolveActorUserId` in
// `packages/api/src/index.ts`).
//
// `displayName` is the human-readable label used in the
// Notification dropdown (4.10) and the assignment modal (4.6).
model User {
  id          String    @id
  role        UserRole_
  displayName String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignedIncidents     Incident[]      @relation("IncidentAssignee")
  incidentEvents        IncidentEvent[] @relation("IncidentEventActor")
  acknowledgedNotifs    Notification[]  @relation("NotificationAcknowledger")
  uploadedAttachments   Attachment[]    @relation("AttachmentUploader")
  alertAcknowledgements Alert[]         @relation("AlertAcknowledger")
  // Story 5.3 — `AuditLog.actorUserId` FK back-relation. Named
  // `UserAuditLogs` so the audit-log seam is discoverable in
  // `schema.prisma` (the Alert / Incident / Notification reverse
  // relations follow the same `ParentChild` naming convention;
  // `UserAuditLogs` reads as "the User → AuditLog set this user
  // authored").
  auditLogs             AuditLog[]      @relation("UserAuditLogs")
}

// Story 4.2 — UserRole enum. Mirrors `RoleSchema` in
// `packages/shared/src/rbac.ts` 1:1; drift is caught at the
// boundary by the existing RBAC matrix lint rules.
enum UserRole_ {
  Admin
  Operator
  Technician
  Viewer
}

// Story 3.1 — Rule enums (BRD §8.3.1, architecture §4.1).
// Prisma enums (not free strings) so Story 3.2's engine, Story 3.3's
// seed, and Story 3.7's admin tab share one source of truth at the
// type layer. Each literal here MUST match the matching entry in
// `packages/shared/src/rule.ts` 1:1; the source-walk pin in
// `packages/db/__tests__/rule-table.schema.spec.ts` catches drift.

// Metric keys a Rule can target. Frozen at the v1 set — adding a key
// in v2 requires a Prisma migration that drops + recreates the type.
enum RuleMetric {
  ph
  tds_ppm
  turbidity_ntu
  chlorine_ppm
  temp_c
  water_level_cm
}

// Comparison operators a Rule can apply. Stored as camel-case TS
// identifiers because Prisma enums must be valid identifiers;
// Story 3.2's engine maps them to JS comparators at evaluation time.
enum RuleOperator {
  gte
  gt
  lte
  lt
  eq
}

// Severity stamped onto a fired alert. Mirrors the wire-contract
// severity set; invariant I-6 — severity is set by the rule, not
// inferred by the engine.
enum RuleSeverity {
  info
  warning
  critical
}

// v1 closed enum of rule types (architecture §4.2, invariant I-5).
// Story 3.2's engine supports exactly these three.
enum RuleRuleType {
  instant
  rate
  absence
}

// Rule — Story 3.1 (architecture §4.1, BRD §8.3.1).
// The typed source of truth for the rules engine. Field order below
// matches the AC: `id`, `deviceId`, `metric`, `operator`, `threshold`,
// `severity`, `ruleType`, `minDurationSeconds`, `hysteresisSeconds`,
// `version`, `createdBy`, `createdAt`, `updatedAt`, `isActive`.
//
// `deviceId` is `String?` (nullable = global rule when NULL). The
// optional FK to `Device.id` cascades on delete so a removed Device
// does not leave orphan Rule rows behind. NULL rows coexist in the
// unique constraint because Postgres treats NULLs as distinct by
// default.
//
// `createdBy` is intentionally a free `String?` (NOT an FK to
// `User`) — the `User` table does not exist in the schema yet. When
// the User migration lands in a future story, a follow-up migration
// adds `references: [id]`. The current nullable string is
// forward-compatible.
//
// `threshold` is the AC-mandated column name; the wire-contract field
// is `value` (architecture §4.1). Story 3.2's engine maps DB
// `threshold` → wire `value` at the engine boundary. Out of scope
// for 3.1 to resolve that drift.
//
// Unique constraint `@@unique([deviceId, metric, operator, threshold, version])`
// is the per-version disambiguator that lets Story 3.7 insert a new
// `isActive: true` row alongside an `isActive: false` previous version.
model Rule {
  id                 String       @id @default(uuid())
  deviceId           String?
  metric             RuleMetric
  operator           RuleOperator
  threshold          Float
  severity           RuleSeverity
  ruleType           RuleRuleType
  minDurationSeconds Int
  hysteresisSeconds  Int
  version            Int          @default(1)
  createdBy          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  isActive           Boolean      @default(true)

  // F-P8 (mirrors Reading/Incident FK contract): enforce the
  // device_id authority at the DB layer. A rule with a bogus
  // deviceId is rejected with a FK violation; ON DELETE CASCADE
  // keeps a removed Device from leaving orphan Rule rows behind.
  device Device? @relation("DeviceRules", fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Story 3.4 — Alert rows reference the Rule that fired them.
  // ON DELETE CASCADE collapses the Device → Rule → Alert chain
  // on a device remove (a Rule independent of the Device that
  // fires against it does not cascade-delete; if the Rule itself
  // is removed, Alerts referencing it cascade).
  alerts Alert[] @relation("RuleAlerts")

  @@unique([deviceId, metric, operator, threshold, version])
}

// Alert — Story 3.4 (architecture §5.1, BRD §8.3.1).
// The row is the per-`(deviceId, metric, severity)` alert lifecycle.
// `ruleId` records which Rule fired the alert; `severity` and `metric`
// are duplicated on the Alert row (rather than joined via Rule) so the
// `findOpenAlert` lookup is a single indexed scan without joining Rule.
// `openedAt` is set at rising edge; `clearedAt` is set at falling edge
// (NULL while open). `acknowledgedAt` lands here as a forward-compatible
// nullable column so Story 3.5's acknowledge flow does not need a
// migration; it stays NULL in 3.4.
//
// Indexes:
//   - (deviceId, metric, severity) — `findOpenAlert` lookup
//     (3.4 idempotency + 3.5 linked-alerts collapse seam).
//   - (deviceId, metric, severity, clearedAt) — operator dashboard
//     list (open alerts + recently cleared alerts by key).
// Partial unique index `WHERE clearedAt IS NULL` (at-most-one-open per
// key) lives in the migration SQL — Prisma `@@unique` does not support
// SQL WHERE predicates.
model Alert {
  id                   String       @id @default(uuid())
  deviceId             String
  ruleId               String
  severity             RuleSeverity
  metric               RuleMetric
  openedAt             DateTime     @default(now())
  clearedAt            DateTime?
  acknowledgedAt       DateTime?
  // Story 3.5 — operator who clicked the "Acknowledge" button. Plain
  // column, NOT a foreign key: the `User` table lands in Epic 5 and the
  // FK constraint is added in that migration. The column is nullable
  // so existing 3.4-shipped rows are valid without backfill; after
  // acknowledge, both `acknowledgedAt` and `acknowledgedByUserId` are
  // set via a single compare-and-set `updateMany` (see
  // `packages/api/src/alerts/acknowledgeRouter.ts`).
  acknowledgedByUserId String?

  device         Device         @relation("DeviceAlerts", fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rule           Rule           @relation("RuleAlerts", fields: [ruleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Story 4.2 — back-fill the `acknowledgedByUserId` FK relation on
  // the User model (`AlertAcknowledger`). The Alert column itself
  // has been `String?` since Story 3.5; this relation makes the
  // FK constraint live.
  acknowledgedBy User?          @relation("AlertAcknowledger", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Story 4.9 — notifications can attach to an Alert directly
  // (warning notifications from auto-create). ON DELETE SET NULL
  // because removing an alert must NOT cascade-delete its
  // notification history.
  notifications  Notification[] @relation("AlertNotifications")

  @@index([deviceId, metric, severity])
  @@index([deviceId, metric, severity, clearedAt])
  // Patch (spec-3-4 review 2026-08-27, P-L2-22 / BH-02): index
  // on ruleId alone so Story 3.5's "list alerts grouped by rule"
  // query and the alert-manager seam don't seq-scan as the table
  // grows. The partial unique index `Alert_open_unique_idx`
  // (`deviceId, metric, severity WHERE clearedAt IS NULL`)
  // doesn't help a query that filters by `ruleId` only.
  @@index([ruleId])
}

// RuleDebounceState — Story 3.4 (architecture §5.1, FR-14).
// The de-bounce timer state per `(deviceId, metric, severity)`. The
// `@@unique` constraint is the schema-level enforcement of the FR-14
// key; range-rule halves collapse to one timer (they share severity
// and metric) and severity is independent (warning + critical run
// two timers). `inViolationSince` is set on the rising edge (raw
// breach present); `clearedSince` is set on the falling edge (no raw
// breach). Both are nullable — a fresh device has no row, a long-quiet
// device has `inViolationSince: null, clearedSince: lastSeen.ts`.
// `deviceId` FK CASCADE drops state rows on a removed Device (no ghost
// timers on re-add).
model RuleDebounceState {
  id               String       @id @default(uuid())
  deviceId         String
  metric           RuleMetric
  severity         RuleSeverity
  inViolationSince DateTime?
  clearedSince     DateTime?

  device Device @relation("DeviceRuleDebounceStates", fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([deviceId, metric, severity])
}

// Story 5.3 — `AuditLog` table. The v1 audit writer (Story 1.5)
// writes a Pino log line; Story 5.6 swaps that writer to land rows
// here. This story ships the table + read surface first so the
// Admin can browse the trail once the writer is flipped.
//
// Mirrors `IncidentEvent` (4.2) shape 1:1:
//   - `id` (UUIDv4, server-generated).
//   - `actorUserId` (FK SET NULL to `User` — the audit row MUST
//      outlive its actor; a deleted Admin's `rbac_allowed` rows
//      remain forensically valid).
//   - `auditAction` (free String — the closed enum is in
//      `@surakkha/shared/rbac` and Story 5.6 may extract it into
//      the new `audit.ts` module; this story keeps it as a
//      free String per the spec's "Why outcome is a String
//      column rather than a Prisma enum" note).
//   - `resource` (the entity type the action targeted — e.g.
//      `"Incident"`, `"Rule"`, `"User"`).
//   - `resourceId` (the entity id when applicable; null for
//      actions like `logout` that have no resource binding).
//   - `payload` (Json — heterogeneous by design; the writer
//      passes through whatever the call site already has).
//   - `outcome` (free String — three values today: `"success"`,
//      `"failure"`, `"allow"`; kept as String to avoid a Prisma
//      enum migration every time a variant is added).
//   - `createdAt` (server default `now()`).
//
// Indexes:
//   - `@@index([createdAt])` — the default listing
//     (`GET /api/audit/list`) orders by `createdAt DESC`.
//   - `@@index([actorUserId, createdAt])` — the actor-filter
//     branch (`?actorIds=a,b`) reads both columns.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  auditAction String
  resource    String
  resourceId  String?
  payload     Json
  outcome     String
  createdAt   DateTime @default(now())

  actor User? @relation("UserAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
}
