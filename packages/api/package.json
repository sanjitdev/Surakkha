{
  "name": "@surakkha/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend: Express + Socket.IO + Prisma. Handles ingestion, rules, alerts, incident workflow, admin endpoints, and the hourly retention cron. Single Node 20 process (I-9).",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "@surakkha/db": "workspace:*",
    "@surakkha/shared": "workspace:*",
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.7",
    "express": "4.21.0",
    "jsonwebtoken": "9.0.2",
    "pino": "9.4.0",
    "pino-pretty": "11.2.2",
    "socket.io": "4.8.0",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.16.5",
    "@types/ws": "8.5.12",
    "@vitest/coverage-v8": "2.1.1",
    "socket.io-client": "4.8.0",
    "tsx": "4.19.1",
    "typescript": "5.5.4",
    "vitest": "2.1.1"
  }
}
