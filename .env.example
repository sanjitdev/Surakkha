# Surakkha — Environment Variables (development).
# Copy to .env and fill in. The api process fails fast on a missing or weak JWT_SECRET.

# --- Required -----------------------------------------------------------------
# HS256 JWT secret. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters

# Postgres connection string used by the api and the db migrations.
# The default matches the docker-compose service name `db`.
DATABASE_URL=postgresql://surakkha:surakkha@db:5432/surakkha

# --- Simulator ----------------------------------------------------------------
# When set, the /admin/simulator tab is enabled and the simulator accepts
# scenario-change commands. When unset, the tab shows:
#   "Simulator disabled. Set SIMULATOR_SECRET."
# The api refuses all /admin/simulator requests without this shared secret.
SIMULATOR_SECRET=replace-me-with-a-shared-secret-for-the-admin-simulator-tab

# --- Retention / aggregation cron ---------------------------------------------
# Standard 5-field cron. The default is "5 minutes past every hour" which spreads
# cron load across the hour. The retention job caps at 10,000 rows per run (I-15).
RETENTION_CRON=5 * * * *

# --- Local development only (used by docker-compose healthcheck) --------------
POSTGRES_USER=surakkha
POSTGRES_PASSWORD=surakkha
POSTGRES_DB=surakkha
